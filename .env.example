# Server-only delivery settings. Never put real credentials in this file.
# Configure these as environment variables in the serverless host.

# Email (Resend)
RESEND_API_KEY=
INGREDIENT_EMAIL_FROM=The Kitchen Table <ingredients@yourdomain.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
